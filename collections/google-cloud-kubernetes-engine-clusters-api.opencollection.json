            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "location",
                "value": "",
                "type": "path"
              },
              {
                "name": "clusterId",
                "value": "",
                "type": "path"
              }
            ]
