        },
        {
          "info": {
            "name": "Google Cloud Kubernetes Engine Get Cluster",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://container.googleapis.com/v1/projects/:projectId/locations/:location/clusters/:clusterId",
            "params": [
              {
